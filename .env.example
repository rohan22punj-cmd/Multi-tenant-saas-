# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── MongoDB ───
MONGODB_URI=mongodb://mongo:27017/multitenant

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── JWT ───
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Logging ───
# Pino log level: fatal, error, warn, info, debug, trace (default: info)
LOG_LEVEL=info

# ─── Signup Rate Limiting ───
# Max signup attempts per IP within the window (default: 5 per 15 min)
SIGNUP_RATE_LIMIT_WINDOW_MS=900000
SIGNUP_RATE_LIMIT_MAX=5

# ─── Login Rate Limiting ───
# Max login attempts per IP within the window (default: 10 per 15 min)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ─── Stripe (test mode) ───
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
