# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── API Documentation ───
# Set to "true" to enable Swagger UI at /api/docs and raw spec at /api/docs.json
# In production, docs are disabled by default (NODE_ENV=production hides them).
# Enable with ENABLE_API_DOCS=true if you need them in production.
ENABLE_API_DOCS=false

# ─── MongoDB ───
MONGODB_URI=mongodb://mongo:27017/multitenant

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── JWT ───
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Logging ───
# Pino log level: fatal, error, warn, info, debug, trace (default: info)
LOG_LEVEL=info

# ─── Instant Revocation ───
# If Redis is down, should protect.js fail-open (allow request, log warning)
# or fail-closed (return 401)? Default: open (safer for availability).
# fail-open: Redis down → allow request, log loud warning.
# fail-closed: Redis down → return 401.
REVOCATION_FAIL_MODE=open

# ─── Signup Rate Limiting ───
# Max signup attempts per IP within the window (default: 5 per 15 min)
SIGNUP_RATE_LIMIT_WINDOW_MS=900000
SIGNUP_RATE_LIMIT_MAX=5

# ─── Login Rate Limiting ───
# Max login attempts per IP within the window (default: 10 per 15 min)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ─── Invite ───
# Default expiry time for invites in days (default: 7)
INVITE_EXPIRY_DAYS=7

# ─── Stripe (test mode) ───
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
